# Run against a debug simulator Apollo process with the tweak loaded:
# xcrun lldb --batch -p <PID> -s tests/profile_username_copy_regression.lldb
# These are detached UIKit component tests, not simulated user gestures.
# No account/preferences/network or clipboard state is changed. Test actual
# clipboard selection/cancellation using the accompanying manual checklist.
thread select 1
expression -l objc++ -- @import UIKit
expression -l objc++ -- NSMutableArray *$copyResults = [NSMutableArray new];
expression -l objc++ -- void (^$copyCheck)(NSMutableArray *, BOOL, NSString *) = ^(NSMutableArray *results, BOOL passed, NSString *name) { [results addObject:[NSString stringWithFormat:@"%@: %@", passed ? @"PASS" : @"FAIL", name]]; };
# UIKit can add auxiliary interactions; count only the context menu we own.
expression -l objc++ -- NSUInteger (^$copyMenuCount)(NSArray *) = ^NSUInteger(NSArray *interactions) { NSUInteger count = 0; for (NSObject *item in interactions) { if ([NSStringFromClass(item.class) isEqualToString:@"UIContextMenuInteraction"]) count++; } return count; };
expression -l objc++ -- UILabel *$copyLabel = [UILabel new]; $copyLabel.text = @"Different Display Name"; ApolloProfileConfigureUsernameCopyTarget($copyLabel, @" u/iamthatis "); ApolloProfileConfigureUsernameCopyTarget($copyLabel, @"iamthatis");
expression -l objc++ -- NSArray *$copyInteractions = $copyLabel.interactions; $copyCheck($copyResults, $copyMenuCount($copyInteractions) == 1, @"Repeated configuration installs one menu"); $copyCheck($copyResults, NSClassFromString(@"ApolloProfileUsernameCopyHandler") == Nil, @"Immediate-copy long-press handler removed");
expression -l objc++ -- UIContextMenuInteraction *$copyInteraction = $copyInteractions.firstObject; id<UIContextMenuInteractionDelegate> $copyDelegate = $copyInteraction.delegate;
# Obtain the unused point from UIKit to avoid duplicate SDK/DWARF CGPoint
# definitions in LLDB. This does not exercise real navigation-bar hit testing.
expression -l objc++ -- UIContextMenuConfiguration *$copyConfiguration = (UIContextMenuConfiguration *)[$copyDelegate contextMenuInteraction:$copyInteraction configurationForMenuAtLocation:[UIBezierPath new].currentPoint]; $copyCheck($copyResults, $copyConfiguration != nil, @"Visible detailed-profile name offers a menu");
# UIKit exposes the provider only privately; KVC is used strictly by this test
# to invoke the same deferred provider without displaying a context menu.
expression -l objc++ -- UIMenu *(^$copyProvider)(NSArray *) = [$copyConfiguration valueForKey:@"actionProvider"]; UIMenu *$copyMenu = $copyProvider(@[]); UIAction *$copyAction = (UIAction *)$copyMenu.children.firstObject; $copyCheck($copyResults, $copyMenu.children.count == 1 && [$copyAction.title isEqualToString:@"Copy Username"], @"Menu matches PR 202");
expression -l objc++ -- UIViewController *$copyController = [UIViewController new]; UIView *$copyTitle = (UIView *)[[NSClassFromString(@"ApolloProfileNavTitleView") alloc] initWithTitle:@"iamthatis"]; $copyController.navigationItem.titleView = $copyTitle; UILabel *$copyTitleLabel = [$copyTitle valueForKey:@"titleLabel"]; UIView *$copyTitleTarget = ApolloProfileUsernameCopyTargetForController($copyController, @"iamthatis"); ApolloProfileConfigureUsernameCopyTarget($copyTitleTarget, @"iamthatis"); $copyCheck($copyResults, $copyTitleTarget == $copyTitle && $copyTitle.userInteractionEnabled, @"Native uses the interactive title wrapper"); $copyCheck($copyResults, $copyTitleLabel.accessibilityCustomActions.count == 1 && $copyTitle.accessibilityCustomActions.count == 0, @"Native VoiceOver action belongs to its label");
expression -l objc++ -- UIContextMenuInteraction *$copyTitleInteraction = (UIContextMenuInteraction *)$copyTitle.interactions.firstObject; $copyTitleLabel.alpha = 0; $copyCheck($copyResults, (UIContextMenuConfiguration *)[$copyDelegate contextMenuInteraction:$copyTitleInteraction configurationForMenuAtLocation:[UIBezierPath new].currentPoint] == nil, @"Faded navigation title cannot open a menu"); $copyTitleLabel.alpha = 1; $copyCheck($copyResults, (UIContextMenuConfiguration *)[$copyDelegate contextMenuInteraction:$copyTitleInteraction configurationForMenuAtLocation:[UIBezierPath new].currentPoint] != nil, @"Visible Native/scrolled-in title offers a menu");
# Keep this test window hidden and non-key. It supplies valid preview coordinates
# without presenting a menu or modifying the running app's visible hierarchy.
expression -l objc++ -- UIWindow *$copyWindow = [UIWindow new]; [$copyWindow addSubview:$copyLabel]; [$copyLabel sizeToFit]; [$copyWindow addSubview:$copyTitle]; [$copyTitle sizeToFit];
expression -l objc++ -- UITargetedPreview *$copyHighlight = (UITargetedPreview *)[$copyDelegate contextMenuInteraction:$copyInteraction previewForHighlightingMenuWithConfiguration:$copyConfiguration]; $copyCheck($copyResults, $copyHighlight != nil && $copyHighlight.view != $copyLabel && $copyHighlight.view.superview == nil && $copyHighlight.view.subviews.count == 0 && !$copyHighlight.view.opaque, @"Detailed name uses a detached blank preview, never the label");
expression -l objc++ -- $copyCheck($copyResults, [$copyHighlight.view.backgroundColor isEqual:UIColor.clearColor] && [$copyHighlight.parameters.backgroundColor isEqual:UIColor.clearColor] && $copyHighlight.parameters.shadowPath.empty, @"No preview pixels, background, or shadow can zoom"); $copyCheck($copyResults, $copyHighlight.target.container == $copyWindow && $copyHighlight.target.center.x == $copyLabel.center.x && $copyHighlight.target.center.y == $copyLabel.center.y && $copyHighlight.size.width == $copyLabel.bounds.size.width && $copyHighlight.size.height == $copyLabel.bounds.size.height, @"Blank preview preserves the name's menu anchor and size");
expression -l objc++ -- UITargetedPreview *$copyDismiss = (UITargetedPreview *)[$copyDelegate contextMenuInteraction:$copyInteraction previewForDismissingMenuWithConfiguration:$copyConfiguration]; $copyCheck($copyResults, $copyDismiss == $copyHighlight, @"Legacy opening and closing reuse the blank preview");
expression -l objc++ -- $copyCheck($copyResults, (UITargetedPreview *)[$copyDelegate contextMenuInteraction:$copyInteraction configuration:$copyConfiguration highlightPreviewForItemWithIdentifier:$copyConfiguration.identifier] == $copyHighlight && (UITargetedPreview *)[$copyDelegate contextMenuInteraction:$copyInteraction configuration:$copyConfiguration dismissalPreviewForItemWithIdentifier:$copyConfiguration.identifier] == $copyHighlight, @"Modern opening and closing reuse the blank preview");
expression -l objc++ -- UIContextMenuConfiguration *$copyNavConfiguration = (UIContextMenuConfiguration *)[$copyDelegate contextMenuInteraction:$copyTitleInteraction configurationForMenuAtLocation:[UIBezierPath new].currentPoint]; UITargetedPreview *$copyNavPreview = (UITargetedPreview *)[$copyDelegate contextMenuInteraction:$copyTitleInteraction configuration:$copyNavConfiguration highlightPreviewForItemWithIdentifier:$copyNavConfiguration.identifier]; $copyCheck($copyResults, $copyNavPreview != nil && $copyNavPreview != $copyHighlight && $copyNavPreview.view != $copyTitle && $copyNavPreview.view != $copyTitleLabel && $copyNavPreview.view.subviews.count == 0 && [$copyNavPreview.view.backgroundColor isEqual:UIColor.clearColor], @"Native title has its own contentless preview");
expression -l objc++ -- UILabel *$copySubtitle = [UILabel new]; $copySubtitle.text = @"u/a_very_long_account_username"; [$copySubtitle sizeToFit]; [$copyWindow addSubview:$copySubtitle]; ApolloProfileConfigureUsernameCopyTarget($copySubtitle, @"a_very_long_account_username"); UIContextMenuInteraction *$copySubtitleInteraction = (UIContextMenuInteraction *)$copySubtitle.interactions.firstObject; UIContextMenuConfiguration *$copySubtitleConfiguration = (UIContextMenuConfiguration *)[$copyDelegate contextMenuInteraction:$copySubtitleInteraction configurationForMenuAtLocation:[UIBezierPath new].currentPoint]; UITargetedPreview *$copySubtitlePreview = (UITargetedPreview *)[$copyDelegate contextMenuInteraction:$copySubtitleInteraction configuration:$copySubtitleConfiguration highlightPreviewForItemWithIdentifier:$copySubtitleConfiguration.identifier]; $copyCheck($copyResults, $copySubtitlePreview != nil && $copySubtitlePreview.view != $copySubtitle && $copySubtitlePreview.view.subviews.count == 0 && [$copySubtitlePreview.view.backgroundColor isEqual:UIColor.clearColor], @"Long username subtitle uses the same no-lift treatment");
expression -l objc++ -- $copyCheck($copyResults, $copyWindow.subviews.count == 3 && !$copyLabel.hidden && $copyLabel.alpha == 1 && $copyLabel.transform.a == 1 && $copyLabel.transform.d == 1 && $copyLabel.transform.tx == 0 && $copyLabel.transform.ty == 0 && $copyTitleLabel.alpha == 1, @"Preview creation neither inserts subviews nor transforms/hides names");
expression -l objc++ -- [$copyLabel removeFromSuperview]; [$copyTitle removeFromSuperview]; [$copySubtitle removeFromSuperview]; $copyCheck($copyResults, (UITargetedPreview *)[$copyDelegate contextMenuInteraction:$copyInteraction previewForDismissingMenuWithConfiguration:$copyConfiguration] == $copyHighlight && (UITargetedPreview *)[$copyDelegate contextMenuInteraction:$copyTitleInteraction configuration:$copyNavConfiguration dismissalPreviewForItemWithIdentifier:$copyNavConfiguration.identifier] == $copyNavPreview, @"Dismissal survives profile/title detachment"); ApolloProfileConfigureUsernameCopyTarget($copySubtitle, nil);
expression -l objc++ -- $copyLabel.hidden = YES; $copyCheck($copyResults, (UIContextMenuConfiguration *)[$copyDelegate contextMenuInteraction:$copyInteraction configurationForMenuAtLocation:[UIBezierPath new].currentPoint] == nil, @"Hidden subtitle cannot open a menu"); $copyLabel.hidden = NO;
expression -l objc++ -- ApolloProfileConfigureUsernameCopyTarget($copyLabel, nil); $copyCheck($copyResults, $copyMenuCount($copyLabel.interactions) == 0 && $copyLabel.accessibilityCustomActions.count == 0, @"Invalidated name removes owned menu and accessibility action"); ApolloProfileConfigureUsernameCopyTarget($copyTitle, nil); $copyCheck($copyResults, $copyMenuCount($copyTitle.interactions) == 0 && $copyTitleLabel.accessibilityCustomActions.count == 0, @"Replaced Native title removes menu and label action");
expression -l objc++ -- UILabel *$copyPreview = [UILabel new]; ApolloProfileConfigureUsernameCopyTarget($copyPreview, nil); $copyCheck($copyResults, $copyPreview.interactions.count == 0 && $copyPreview.accessibilityCustomActions.count == 0, @"Preview/missing username never gains copy interaction");
expression -O -l objc++ -- $copyResults
process detach
quit
